{
    "name": "fadillf/log-monitoring",
    "description": "Lightweight terminal-first Laravel observability with private daily structured logs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {"psr-4": {"LogMonitor\\": "src/"}},
    "autoload-dev": {"psr-4": {"LogMonitor\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["LogMonitor\\MonitorServiceProvider"], "aliases": {"Monitor": "LogMonitor\\Facades\\Monitor"}}},
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": false}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
